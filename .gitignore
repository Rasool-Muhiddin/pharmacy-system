# البيئة الافتراضية
venv/
env/
.venv/

# أسرار المشروع — الأهم إطلاقًا
.env
.env.*

# ملفات Python المُصرّفة
__pycache__/
*.pyc
*.pyo

# قاعدة بيانات محلية (إذا تستخدم SQLite للتطوير)
